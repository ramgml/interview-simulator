LOCAL_LLM_BASE_URL=http://localhost:20128/v1
LOCAL_LLM_MODEL=glm/glm-5.3-flash
CLOUD_LLM_BASE_URL=
CLOUD_LLM_API_KEY=
CLOUD_LLM_MODEL=
MLFLOW_TRACKING_URI=sqlite:///data/mlflow.db
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=auto
TTS_VOICE=kseniya
DATABASE_URL=sqlite:///data/app.db
ORPHAN_CLOSE_HOURS=12

# Ленивое автозакрытие осиротевших in_progress-сессий (T158): если последний ход старше
# ORPHAN_CLOSE_HOURS часов, сессия закрывается как отменённая; 0 — автозакрытие выключено.

# Бюджеты генерации (max_tokens) PLAN/TURN/EVAL. На reasoning-моделях (например, glm-5.3-flash на Zhipu)
# рассуждения тоже расходуют этот бюджет: при пустом или обрезанном JSON (finish_reason=length) подними
# лимиты (например, PLAN_MAX_TOKENS=8000) или выбери модель с компактным reasoning (например, glm-4.7).
PLAN_MAX_TOKENS=4000
TURN_MAX_TOKENS=1000
EVAL_MAX_TOKENS=4000
